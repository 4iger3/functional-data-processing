{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supplier": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  },
  "required": ["sku", "quantity"],
  "additionalProperties": false
}
